generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Pengaturan situs berbentuk key-value (nomor WA, email, sosial media, teks hero, dll.)
model Setting {
  key   String @id @db.VarChar(64)
  value String @db.Text
}

enum PackageCategory {
  AQIQAH_MASAK
  DOMBA_HIDUP
  NASI_BOX
  BUNDLING
}

model Package {
  id             Int             @id @default(autoincrement())
  category       PackageCategory
  name           String
  subtitle       String?
  /// Harga untuk hewan betina / jantan (paket aqiqah & domba hidup & bundling)
  priceBetina    Int?
  priceJantan    Int?
  /// Harga coret (sebelum diskon)
  originalBetina Int?
  originalJantan Int?
  /// Harga tunggal (nasi box, harga per box)
  price          Int?
  sate           Int?
  gule           Int?
  boxCount       Int?
  /// Satu item per baris
  features       String?         @db.Text
  imageUrl       String?
  featured       Boolean         @default(false)
  active         Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orders         Order[]

  @@index([category, sortOrder])
}

model MenuItem {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  imageUrl    String?
  icon        String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  subtitle  String?
  content   String   @db.Text
  imageUrl  String?
  rating    Int      @default(5)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Office {
  id        Int     @id @default(autoincrement())
  name      String
  address   String  @db.Text
  phone     String?
  mapUrl    String? @db.Text
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model Faq {
  id        Int     @id @default(autoincrement())
  question  String  @db.Text
  answer    String  @db.Text
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  /// Markdown sederhana: paragraf, ## judul, - daftar, **tebal**
  content     String    @db.LongText
  coverUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum AnimalSex {
  BETINA
  JANTAN
}

model Order {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  customerName  String
  phone         String
  address       String      @db.Text
  babyName      String
  babyGender    Gender
  babyBirthDate DateTime?   @db.Date
  eventDate     DateTime    @db.Date
  packageId     Int?
  package       Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  /// Salinan nama paket saat order dibuat, agar tetap terbaca bila paket dihapus
  packageName   String
  animalSex     AnimalSex?
  quantity      Int         @default(1)
  notes         String?     @db.Text
  status        OrderStatus @default(BARU)
  /// CRM yang melayani pelanggan, dipilih admin
  crmId         Int?
  crm           Crm?        @relation(fields: [crmId], references: [id], onDelete: SetNull)
  assignedAt    DateTime?
  createdAt     DateTime    @default(now())
  waMessages    WaMessage[]

  @@index([createdAt])
  @@index([phone])
}

enum OrderStatus {
  BARU
  DIPROSES
  SELESAI
  BATAL
}

/// Petugas CRM yang melayani pelanggan lewat WhatsApp pribadinya
model Crm {
  id        Int      @id @default(autoincrement())
  name      String
  /// Format 62…
  phone     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  orders    Order[]
}

enum WaDirection {
  IN
  OUT
}

/// Log semua pesan WhatsApp lewat gateway (keluar & masuk)
model WaMessage {
  id        Int         @id @default(autoincrement())
  direction WaDirection
  /// Nomor lawan bicara, format 62…
  number    String
  name      String?
  message   String      @db.Text
  /// Jenis pesan, mis. order_new_customer, assign_crm, forward_crm, auto_reply, status_reply, incoming
  purpose   String      @db.VarChar(40)
  orderId   Int?
  order     Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ok        Boolean     @default(true)
  error     String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([number, createdAt])
  @@index([orderId])
  @@index([createdAt])
}

model HeroSlide {
  id             Int     @id @default(autoincrement())
  eyebrow        String?
  /// Teks di antara *bintang* ditampilkan emas miring
  title          String  @db.Text
  subtitle       String? @db.Text
  imageUrl       String?
  primaryLabel   String?
  primaryUrl     String?
  secondaryLabel String?
  secondaryUrl   String?
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
}
